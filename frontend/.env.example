# Backend API base URL (optional in dev — Vite proxy may be used)
# VITE_API_URL=http://localhost:8000

# ZITADEL frontend auth configuration
# VITE_ZITADEL_ISSUER=https://zitadel-nonprod.example.com
# VITE_ZITADEL_CLIENT_ID=decision-arena-frontend
# VITE_ZITADEL_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
# VITE_ZITADEL_SCOPE=openid profile email
# VITE_ZITADEL_AUDIENCE=decision-arena-api
# VITE_ZITADEL_DISCOVERY_URL=
# VITE_ZITADEL_ROLES_CLAIM=role

# Intro video embed URL (YouTube or Vimeo watch/embed link)
# VITE_INTRO_VIDEO_URL=https://www.youtube.com/watch?v=EXAMPLE

# Google Analytics measurement ID (production only, consent-gated)
# VITE_GA_MEASUREMENT_ID=G-GFBBZSFESV
